#include <iostream>
using namespace std;

int main()
{
    char str1[100], str2[100];
    int choice, i, length;

    cout << "Enter first string: ";
    cin.getline(str1, 100);

    do
    {
        cout << "\n===== STRING MENU =====\n";
        cout << "1. Find Length\n";
        cout << "2. Copy String\n";
        cout << "3. Concatenate String\n";
        cout << "4. Reverse String\n";
        cout << "5. Compare Strings\n";
        cout << "6. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;
        cin.ignore();

        switch(choice)
        {
            case 1:
                length = 0;
                while(str1[length] != '\0')
                    length++;

                cout << "Length = " << length << endl;
                break;

            case 2:
                cout << "Copied String: ";
                for(i = 0; str1[i] != '\0'; i++)
                    str2[i] = str1[i];

                str2[i] = '\0';
                cout << str2 << endl;
                break;

            case 3:
                cout << "Enter second string: ";
                cin.getline(str2, 100);

                length = 0;
                while(str1[length] != '\0')
                    length++;

                for(i = 0; str2[i] != '\0'; i++)
                    str1[length + i] = str2[i];

                str1[length + i] = '\0';

                cout << "Concatenated String: " << str1 << endl;
                break;

            case 4:
                length = 0;
                while(str1[length] != '\0')
                    length++;

                cout << "Reversed String: ";
                for(i = length - 1; i >= 0; i--)
                    cout << str1[i];

                cout << endl;
                break;

            case 5:
                cout << "Enter second string: ";
                cin.getline(str2, 100);

                i = 0;
                while(str1[i] == str2[i] && str1[i] != '\0' && str2[i] != '\0')
                    i++;

                if(str1[i] == '\0' && str2[i] == '\0')
                    cout << "Strings are Equal." << endl;
                else
                    cout << "Strings are Not Equal." << endl;

                break;

            case 6:
                cout << "Exiting Program..." << endl;
                break;

            default:
                cout << "Invalid Choice!" << endl;
        }

    } while(choice != 6);

    return 0;
}